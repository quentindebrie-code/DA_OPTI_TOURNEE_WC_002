# Copiez ce fichier en « secrets.toml » (jamais commité) pour un usage local,
# ou collez son contenu dans Streamlit Cloud → App → Settings → Secrets.
[supabase]
url = "https://VOTRE-PROJET.supabase.co"
# Clé SECRÈTE (Project Settings → API Keys → « secret » sb_secret_…,
# ou l'ancienne clé « service_role »). Elle reste côté serveur Streamlit.
key = "sb_secret_XXXXXXXXXXXXXXXXXXXX"
